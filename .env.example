# Alpha Vantage API key (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=your_key_here

# Optional: Firebase Realtime Database write target
# If provided, the refresh script will also push latest returns to RTDB.
# For Node scripts you need a service account or database secret.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
